  "triggers": [
    {
      "TRIGGER_NAME": "trg_blog_content_words_del",
      "EVENT_MANIPULATION": "DELETE",
      "EVENT_OBJECT_TABLE": "blog_content",
      "ACTION_TIMING": "AFTER",
      "ACTION_STATEMENT": "BEGIN\n    UPDATE `blog` SET `word_count` = NULL WHERE `id` = OLD.`blog_id`;\nEND"
    },
    {
      "TRIGGER_NAME": "trg_blog_content_words_ins",
      "EVENT_MANIPULATION": "INSERT",
      "EVENT_OBJECT_TABLE": "blog_content",
      "ACTION_TIMING": "AFTER",
      "ACTION_STATEMENT": "BEGIN\n    UPDATE `blog` SET `word_count` = CHAR_LENGTH(COALESCE(NEW.`content`,''))\n     WHERE `id` = NEW.`blog_id`;\nEND"
    },
    {
      "TRIGGER_NAME": "trg_blog_content_words_upd",
      "EVENT_MANIPULATION": "UPDATE",
      "EVENT_OBJECT_TABLE": "blog_content",
      "ACTION_TIMING": "AFTER",
      "ACTION_STATEMENT": "BEGIN\n    IF NOT (NEW.`content` <=> OLD.`content`) THEN\n        UPDATE `blog` SET `word_count` = CHAR_LENGTH(COALESCE(NEW.`content`,''))\n         WHERE `id` = NEW.`blog_id`;\n    END IF;\nEND"
    }
  ],
